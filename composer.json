{
    "name": "celerik/ui",
    "description": "Open-source, Bootstrap-based UI component suite for PHP, with optional Laravel and Symfony adapters.",
    "homepage": "https://kivudesign.github.io/celerik/",
    "support": {
        "docs": "https://kivudesign.github.io/celerik/",
        "issues": "https://github.com/kivudesign/celerik/issues",
        "source": "https://github.com/kivudesign/celerik"
    },
    "type": "library",
    "license": "MIT",
    "keywords": ["ui", "components", "bootstrap", "datatables", "chartjs", "laravel", "symfony", "grid", "chart", "form"],
    "authors": [
        {
            "name": "Boss",
            "email": "ibmussafb@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "doctrine/orm": "^3.3",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "studio-42/elfinder": "^2.1.70",
        "symfony/cache": "^7.2",
        "symfony/html-sanitizer": "^7.2",
        "twig/twig": "^3.14"
    },
    "suggest": {
        "laravel/framework": "Laravel 11+ for the Blade components and Eloquent data source",
        "symfony/framework-bundle": "Symfony 7 for the bundle and Twig extension",
        "twig/twig": "Required by the Symfony Twig extension",
        "doctrine/orm": "Required by the Doctrine data and event sources",
        "symfony/html-sanitizer": "Required by EditorHtml::sanitize() to clean rich text editor output",
        "ext-fileinfo": "Required by UploadHandler to detect the real MIME type of uploads",
        "studio-42/elfinder": "Required by the File Manager (connector, JS and CSS)"
    },
    "autoload": {
        "psr-4": {
            "Celerik\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Celerik\\Ui\\Tests\\": "tests/php/"
        }
    },
    "bin": ["bin/celerik-theme"],
    "extra": {
        "laravel": {
            "providers": [
                "Celerik\\Ui\\Adapters\\Laravel\\CelerikServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "fixtures": "php tests/js/fixtures/build.php"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
