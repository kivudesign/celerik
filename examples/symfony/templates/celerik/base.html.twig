<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %} — Celerik UI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery@4.0.0/dist/jquery.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    {# The theme saved with the theme builder (CelerikThemeController), if any. #}
    {% set saved = celerik_saved_theme() %}
    {{ celerik_assets(asset('bundles/celerikui'), theme: saved.base ?? 'bootstrap', customTheme: saved.url ?? null) }}
</head>
<body>
<nav class="navbar navbar-expand bg-body-tertiary mb-4" aria-label="Examples">
    <div class="container">
        <span class="navbar-brand">Celerik UI</span>
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_grid') }}">Grid</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_chart') }}">Chart</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_form') }}">Form</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_scheduler') }}">Scheduler</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_article') }}">Article</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_ui') }}">Tabs &amp; modal</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('celerik_files') }}">Files</a></li>
            {% if app.environment == 'dev' %}
                <li class="nav-item"><a class="nav-link" href="{{ path('celerik_theme') }}">Theme builder</a></li>
            {% endif %}
        </ul>
    </div>
</nav>
<main class="container">
    <h1 class="h3 mb-4">{{ block('title') }}</h1>
    {% block content %}{% endblock %}
</main>
</body>
</html>
