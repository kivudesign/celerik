{
  "name": "@celerikui/ui",
  "version": "0.1.0",
  "description": "The JavaScript and CSS bundle of Celerik UI, the accessible Bootstrap-based PHP component suite.",
  "homepage": "https://kivudesign.github.io/celerik/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kivudesign/celerik.git"
  },
  "bugs": "https://github.com/kivudesign/celerik/issues",
  "keywords": [
    "ui",
    "components",
    "bootstrap",
    "php",
    "laravel",
    "symfony",
    "accessibility"
  ],
  "files": [
    "public/**/*.js",
    "public/**/*.css"
  ],
  "browser": "./public/celerik.js",
  "style": "./public/celerik.css",
  "exports": {
    ".": "./public/celerik.js",
    "./celerik.css": "./public/celerik.css",
    "./celerik-material.css": "./public/celerik-material.css",
    "./celerik-tailwind.css": "./public/celerik-tailwind.css",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint resources/js tests/js tests/browser site playwright.config.mjs playwright.site.config.mjs tests/site",
    "pretest": "php tests/js/fixtures/build.php",
    "test": "jest",
    "test:a11y": "playwright test",
    "test:site": "playwright test -c playwright.site.config.mjs",
    "docs:demos": "php site/demos/build.php",
    "docs:reference": "php site/tools/reference.php",
    "docs:generate": "npm run docs:demos && npm run docs:reference",
    "predocs:dev": "npm run docs:generate",
    "predocs:build": "npm run docs:generate",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "jquery": "^3.7.1 || ^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^9.17.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.10.2",
    "babel-jest": "^29.7.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.4.7",
    "datatables.net-bs5": "^2.1.8",
    "datatables.net-buttons-bs5": "^3.2.0",
    "eslint": "^9.17.0",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "globals": "^15.14.0",
    "inputmask": "^5.0.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "lodash": "^4.18.1",
    "notyf": "^3.10.0",
    "parsleyjs": "^2.9.2",
    "quill": "^2.0.3",
    "sass": "^1.83.0",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  }
}
